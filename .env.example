# Local development (`npm run dev`, `npm run deploy:dev`). Copy to .env and fill in. Never commit .env.
# Production values live in GitHub Actions secrets/variables (see .github/workflows/deploy-prod.yml).
PORT=3000
STAGE=dev

# AWS credentials: used by `npm run deploy:dev`, and locally only by the webhook (SQS enqueue)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Secrets
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/waslah
WA_ACCESS_TOKEN=
WA_APP_SECRET=
# Any random string; enter the same one in Meta's webhook settings
WA_VERIFY_TOKEN=
# Random string, at least 32 chars, used to sign user JWTs
JWT_SECRET=

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_GRAPH_API_VERSION=v24.0
# Local only: the deployed functions get this from serverless.yml
WA_INBOUND_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/waslah-dev-wa-inbound

# Bootstrap admin for `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
