# Local development (`npm run dev`). Copy to .env and fill in. Never commit .env.
PORT=3000
STAGE=dev

# AWS credentials used to read the secrets below from Secrets Manager
AWS_PROFILE=default
AWS_REGION=us-east-1

# Secrets Manager ARNs (created by `npm run deploy:dev`)
MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:waslah/dev/mongodb-uri-xxxxxx
WA_ACCESS_TOKEN_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:waslah/dev/wa-access-token-xxxxxx
WA_APP_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:waslah/dev/wa-app-secret-xxxxxx
WA_VERIFY_TOKEN_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:waslah/dev/wa-verify-token-xxxxxx
JWT_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:waslah/dev/jwt-secret-xxxxxx

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_GRAPH_API_VERSION=v24.0
WA_INBOUND_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT/waslah-dev-wa-inbound
